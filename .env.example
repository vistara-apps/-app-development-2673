# EcoStyle Match Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your-openai-api-key-here

# Supabase Configuration
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Farcaster Configuration (Optional)
# Get your API key from: https://neynar.com/
VITE_NEYNAR_API_KEY=your-neynar-api-key-here

# Analytics Configuration (Optional)
# Get your tracking ID from Google Analytics
VITE_GA_TRACKING_ID=your-google-analytics-id

# Development Configuration
NODE_ENV=development
VITE_APP_NAME=EcoStyle Match
VITE_APP_VERSION=1.0.0

# Payment Configuration (Optional)
# Configure payment gateway settings
VITE_PAYMENT_GATEWAY_URL=https://payments.vistara.dev
VITE_PAYMENT_API_KEY=your-payment-api-key

# Feature Flags (Optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_SOCIAL_FEATURES=false

# API Rate Limits (Optional)
VITE_OPENAI_RATE_LIMIT=60
VITE_SUPABASE_RATE_LIMIT=100
